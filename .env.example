# Copia este fichero a .env y rellena las cuentas de prueba. .env está en .gitignore.
BETSSON_COM_USER=
BETSSON_COM_PASS=
BETSSON_COM_NOFUND_USER=
BETSSON_COM_NOFUND_PASS=

# Opcionales
# TARGET_MARKET=betsson_com
# HEADLESS=0          # 0 = ver el navegador
# RECORD_VIDEO=1
# Proxy (p. ej. en España) si Betsson no responde desde tu red / desde los runners de GitHub
# PROXY_SERVER=http://host:puerto
# PROXY_USERNAME=
# PROXY_PASSWORD=
